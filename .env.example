# Copy to .env (same folder as docker-compose.yml) and fill in the values.
# NEVER commit the real .env file.

# --- PostgreSQL (used by the db service and to build the backend DATABASE_URL) ---
POSTGRES_USER=campusbite
POSTGRES_PASSWORD=
POSTGRES_DB=campusbite

# --- Backend ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=120
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI (optional - AI insights return 503 until set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=5

REMINDER_THRESHOLD_MINUTES=15
REMINDER_SCAN_INTERVAL_SECONDS=60
SEED_DEMO_DATA=true

# Host ports
BACKEND_PORT=8000
POSTGRES_PORT=5432
