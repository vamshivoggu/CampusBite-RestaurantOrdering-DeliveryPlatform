# Copy to backend/.env when running the backend WITHOUT Docker (plain uvicorn).
# For Docker Compose, use the .env file in the project root instead (see ../.env.example).

ENVIRONMENT=development
LOG_LEVEL=INFO

# SQLite for quick local runs. PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/campusbite
DATABASE_URL=sqlite:///./campusbite.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenAI (AI insights return 503 until this is set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_RATE_LIMIT_PER_MINUTE=5

REMINDER_THRESHOLD_MINUTES=15
REMINDER_SCAN_INTERVAL_SECONDS=60
ENABLE_REMINDER_SCHEDULER=true

DELIVERY_FEE=30
SEED_DEMO_DATA=true
